# Copy to .env, apps/api/.env, apps/worker/.env and apps/web/.env.local as documented in ENVIRONMENT.md

NODE_ENV=development
LOG_LEVEL=info

# API
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql://sellerstudio:sellerstudio@localhost:5432/sellerstudio

# Redis / jobs
REDIS_URL=redis://127.0.0.1:6379
GENERATION_QUEUE=generation

# Auth: mock | firebase
AUTH_PROVIDER=mock
AUTH_JWT_SECRET=change-me-dev-only-not-for-production
# Firebase (required when AUTH_PROVIDER=firebase)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Frontend Firebase (never put Admin secrets here)
NEXT_PUBLIC_AUTH_PROVIDER=mock
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Storage: local | s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=sellerstudio
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=900

# AI: mock | gemini
AI_PROVIDER=mock
TEXT_MODEL=gemini-3.7-flash
IMAGE_MODEL=gemini-3.1-flash-lite-image
PREMIUM_IMAGE_MODEL=gemini-3.1-flash-lite-image
GEMINI_API_KEY=

# Payments: mock | razorpay
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_PAYMENT_PROVIDER=mock
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Background removal: heuristic | http
BG_REMOVAL_PROVIDER=heuristic
BG_REMOVAL_HTTP_URL=
BG_REMOVAL_HTTP_TOKEN=

# Credits
SIGNUP_BONUS_CREDITS=4

# Uploads
MAX_UPLOAD_BYTES=10485760
ALLOWED_IMAGE_MIME=image/jpeg,image/png,image/webp

# Worker
WORKER_CONCURRENCY=2
FFMPEG_PATH=ffmpeg
